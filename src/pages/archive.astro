---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostsForArchive } from "../utils/content-utils";

const { timeOrdered, readingOrdered } = await getPostsForArchive();
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel timeSortedPosts={timeOrdered} readingOrderedPosts={readingOrdered} client:only="svelte"></ArchivePanel>
</MainGridLayout>

