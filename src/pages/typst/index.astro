---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { compileToSvg, scanTypstFiles } from "@utils/typst-compiler";

const docs = scanTypstFiles().map((f) => ({ ...f, compiled: compileToSvg(f) }));

const categories = [
	...new Set(docs.map((d) => d.meta.category).filter(Boolean)),
];

const CATEGORY_LABELS: Record<string, string> = {
	resume: "简历",
	review: "复习资料",
	demo: "功能展示",
};
---

<MainGridLayout
	title="Typst 文档"
	description="使用 Typst 排版引擎生成的文档"
	hideSidebar={true}
>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
			<h1 class="text-3xl font-bold mb-6 text-black/90 dark:text-white/90">
				Typst 文档
			</h1>

			{
				categories.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-8">
						{categories.map((cat) => (
							<a
								href={`/typst/category/${cat}/`}
								class="btn-regular h-9 text-sm px-4 rounded-lg inline-flex items-center gap-1.5"
							>
								{CATEGORY_LABELS[cat] || cat}
							</a>
						))}
					</div>
				)
			}

			{
				docs.length === 0 ? (
					<p class="text-neutral-500 dark:text-neutral-400">
						暂无 Typst 文档。在 <code>typst/</code> 目录下添加 <code>.typ</code> 文件。
					</p>
				) : (
					<div class="typst-card-grid">
						{docs
							.sort((a, b) => (b.meta.pinned ? 1 : 0) - (a.meta.pinned ? 1 : 0) || (a.meta.order ?? 99) - (b.meta.order ?? 99))
							.map(({ slug, meta, compiled }) => (
							<a
								href={`/typst/${slug}/`}
								class="typst-card group"
								style={`--cover-aspect: ${compiled.coverAspect}`}
							>
								<div class="typst-card-cover">
									<div set:html={compiled.coverSvg} />
								</div>
								<div class="typst-card-footer">
									<h3 class="typst-card-title">{meta.title}</h3>
									{meta.description && (
										<p class="typst-card-desc">{meta.description}</p>
									)}
									<div class="typst-card-meta">
										{meta.published && <time>{meta.published}</time>}
										{meta.category && (
											<span class="typst-card-badge">{CATEGORY_LABELS[meta.category] || meta.category}</span>
										)}
									</div>
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>

<style is:global>
	.typst-card-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}

	.typst-card {
		display: flex;
		flex-direction: column;
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--card-bg, oklch(1 0 0));
		box-shadow: 0 1px 4px oklch(0 0 0 / 0.06);
		transition: transform 0.2s, box-shadow 0.2s;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}

	.typst-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 16px oklch(0 0 0 / 0.1);
	}

	.typst-card-cover {
		position: relative;
		aspect-ratio: var(--cover-aspect, 0.707);
		overflow: hidden;
		background: #fff;
	}

	.typst-card-cover svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	:root.dark .typst-card-cover svg {
		filter: invert(0.9) hue-rotate(180deg);
	}

	.typst-card-footer {
		padding: 0.75rem 1rem;
	}

	.typst-card-title {
		font-size: 1rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
		color: oklch(0.2 0 0);
	}

	:root.dark .typst-card-title {
		color: oklch(0.85 0 0);
	}

	.typst-card-desc {
		font-size: 0.8rem;
		color: oklch(0.55 0 0);
		margin: 0 0 0.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:root.dark .typst-card-desc {
		color: oklch(0.6 0 0);
	}

	.typst-card-meta {
		display: flex;
		gap: 0.75rem;
		font-size: 0.75rem;
		color: oklch(0.6 0 0);
		align-items: center;
	}

	.typst-card-badge {
		padding: 0.1em 0.5em;
		border-radius: 999px;
		background: oklch(0.9 0.02 250);
		color: oklch(0.4 0.06 250);
		font-size: 0.7rem;
		font-weight: 600;
	}

	:root.dark .typst-card-badge {
		background: oklch(0.25 0.04 250);
		color: oklch(0.7 0.04 250);
	}

	:root.dark .typst-card-meta {
		color: oklch(0.55 0 0);
	}
</style>
