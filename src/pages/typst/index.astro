---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { scanTypstFiles } from "@utils/typst-compiler";

const files = scanTypstFiles();
---

<MainGridLayout title="Typst 文档" description="使用 Typst 排版引擎生成的文档">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
			<h1 class="text-3xl font-bold mb-8 text-black/90 dark:text-white/90">
				Typst 文档
			</h1>

			{
				files.length === 0 ? (
					<p class="text-neutral-500 dark:text-neutral-400">
						暂无 Typst 文档。
					</p>
				) : (
					<div class="grid gap-4 sm:grid-cols-2">
						{files.map((f) => (
							<a
								href={`/typst/${f.slug}/`}
								class="btn-card rounded-xl p-5 block hover:scale-[1.02] active:scale-[0.98] transition-transform"
							>
								<h2 class="text-lg font-bold text-black/80 dark:text-white/80 mb-1">
									{f.meta.title}
								</h2>
								{f.meta.description && (
									<p class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2">
										{f.meta.description}
									</p>
								)}
								{f.meta.tags && (
									<div class="flex flex-wrap gap-1.5 mt-3">
										{f.meta.tags.map((tag) => (
											<span class="text-xs px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/10 text-neutral-600 dark:text-neutral-300">
												{tag}
											</span>
										))}
									</div>
								)}
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>
